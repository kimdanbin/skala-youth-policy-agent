# 이 파일을 .env로 복사해서 값을 채우세요 (.env는 git에 올라가지 않습니다)

# 온통청년 Open API 키 (scripts/fetch_policies.py로 정책 데이터를 받을 때 필요)
YOUTH_API_KEY=

# 사용할 LLM: openai(gpt-4o-mini) 또는 ollama(qwen3:8b, 로컬)
LLM_BACKEND=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=qwen3:8b

# LangSmith 트레이싱 (에이전트의 노드·LLM·도구 호출을 계층 트리로 기록)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skala-youth-policy-agent

# (선택) 평가 채점 모델, 날짜 고정(테스트·재현용)
# JUDGE_MODEL=gpt-4o
# FAKE_TODAY=2026-10-22
